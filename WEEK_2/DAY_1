Program for Valid Anagram:

class Solution {
public:
    bool isAnagram(string s, string t) {
        if (s.length() != t.length()) {
            return false;
        }

        vector<int> freq(26, 0);
        for (char ch : s) {
            freq[ch - 'a']++;
        }
         for (char ch : t) {
            freq[ch - 'a']--;
        }
        for (int count : freq) {
            if (count != 0) {
                return false;
            }
        }

        return true;
    }
};

Program for First Unique Character in a String:

class Solution {
public:
    int firstUniqChar(string s) {
        vector<int> freq(26, 0);
        for (char ch : s) {
            freq[ch - 'a']++;
        }

         for (int i = 0; i < s.size(); i++) {
            if (freq[s[i] - 'a'] == 1) {
                return i;
            }
        }

        return -1;
    }
};

Program for Ransom Note:

class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        vector<int> freq(26, 0);
        for (char ch : magazine) {
            freq[ch - 'a']++;
        }

        for (char ch : ransomNote) {
            freq[ch - 'a']--;

            if (freq[ch - 'a'] < 0) {
                return false;
            }
        }

        return true;
    }
};
